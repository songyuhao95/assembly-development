{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/hooks/hook-session-start.mjs\"",
            "commandWindows": "powershell -NoProfile -Command \"& node ((git rev-parse --show-toplevel) + '/scripts/hooks/hook-session-start.mjs')\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/hooks/hook-user-prompt.mjs\"",
            "commandWindows": "powershell -NoProfile -Command \"& node ((git rev-parse --show-toplevel) + '/scripts/hooks/hook-user-prompt.mjs')\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/hooks/hook-pretool.mjs\"",
            "commandWindows": "powershell -NoProfile -Command \"& node ((git rev-parse --show-toplevel) + '/scripts/hooks/hook-pretool.mjs')\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/hooks/hook-tool-failure.mjs\"",
            "commandWindows": "powershell -NoProfile -Command \"& node ((git rev-parse --show-toplevel) + '/scripts/hooks/hook-tool-failure.mjs')\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/hooks/hook-subagent-stop.mjs\"",
            "commandWindows": "powershell -NoProfile -Command \"& node ((git rev-parse --show-toplevel) + '/scripts/hooks/hook-subagent-stop.mjs')\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/hooks/hook-stop.mjs\"",
            "commandWindows": "powershell -NoProfile -Command \"& node ((git rev-parse --show-toplevel) + '/scripts/hooks/hook-stop.mjs')\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
